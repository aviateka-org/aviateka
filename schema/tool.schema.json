{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aviateka-org/aviateka/schema/tool.schema.json",
  "title": "Aviateka tool card / карточка инструмента",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "url", "org", "disciplines", "map", "fidelity", "stages", "aircraft", "summary", "use"],
  "$defs": {
    "text": {
      "description": "Text in Russian and English / текст на русском и английском",
      "type": "object", "additionalProperties": false, "required": ["ru", "en"],
      "properties": {"ru": {"type": "string", "minLength": 3}, "en": {"type": "string", "minLength": 3}}
    },
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
  },
  "properties": {
    "id": {"description": "Lowercase id, same as the file name / имя файла без .yaml", "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "url": {"type": "string", "pattern": "^https?://"},
    "org": {"description": "Who makes it / кто делает", "type": "string"},
    "last_commit": {"description": "Last commit on the default branch, YYYY-MM-DD / дата последнего коммита", "$ref": "#/$defs/date"},
    "license": {"type": "string"},
    "code": {"description": "Languages / языки", "type": "string"},
    "status": {"description": "Only when not computed from last_commit / только если статус не считается по дате",
               "enum": ["active", "stale", "unknown", "legacy", "announced", "proprietary", "commercial", "on_request", "freeware"]},
    "disciplines": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "map": {"description": "[discipline, fidelity] — the chart cell / клетка на карте", "type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
    "fidelity": {"type": "array", "minItems": 1, "items": {"enum": ["L0", "L1", "L2", "L3", "EXP"]}, "uniqueItems": true},
    "stages": {"type": "array", "minItems": 1, "items": {"enum": ["concept", "preliminary", "detail", "test"]}, "uniqueItems": true},
    "aircraft": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "summary": {"$ref": "#/$defs/text"},
    "use": {"$ref": "#/$defs/text"},
    "caveat": {"$ref": "#/$defs/text"},
    "sources": {"description": "Defaults to [url] / по умолчанию [url]", "type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https?://"}}
  }
}
